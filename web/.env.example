# Gold Fortune Merchandising — web environment
#
# Copy to `.env.local` for local development, and set the same names in the
# Vercel project's Environment Variables for production. Real values are never
# committed: `.env*` is gitignored, and this file is the only exception.
#
# Anything prefixed NEXT_PUBLIC_ is compiled into the JavaScript the browser
# downloads. It is readable by anyone using the site — that is fine for the two
# below, and is why NO OTHER KEY MAY EVER BE GIVEN THAT PREFIX. Adding it to a
# service-role or OpenAI key publishes that key to every visitor.

# ── Public: safe in the browser ──────────────────────────────────────────────

# Supabase project REST endpoint.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase publishable (anon) key. Safe to expose: it grants nothing on its own,
# because every table's access is decided by Postgres row-level security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Google Maps JavaScript key, used by the map views in the browser.
# Cannot be hidden — restrict it instead: in Google Cloud set Application
# restrictions to Websites (the production domain + localhost) and API
# restrictions to Maps JavaScript + Places. See docs/DEPLOYMENT-CHECKLIST.md.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ── Secret: server-side only, never prefixed NEXT_PUBLIC_ ────────────────────

# Supabase service-role key. Bypasses row-level security completely — it is the
# keys to every organisation's data. Used only by server routes (creating rep
# accounts, admin operations). If this ever reaches the browser or a git commit,
# rotate it immediately in Supabase → Settings → API.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI key for the AI insights feature. Use a project-scoped key with its own
# monthly budget so another workload cannot spend it.
OPENAI_API_KEY=

# Optional. Defaults to gpt-5.5 when unset (web/app/api/insights/route.ts).
OPENAI_MODEL=

# Google server-side keys for address lookup and store geocoding. Separate from
# the Maps browser key above so each can be restricted and rotated on its own.
GOOGLE_GEOCODING_API_KEY=
GOOGLE_PLACES_API_KEY=

# Google Routes API, for the driving distance of a finished workday
# (web/app/api/workday/road-distance). A *separate* key again, for the same
# reason as the two above: one key per API means each can be restricted to that
# API alone and rotated without taking the others down.
#
# In Google Cloud: enable **Routes API** (this is the part that bills), create a
# key, then restrict it — **Application restrictions: None**, because Vercel's
# serverless IPs are dynamic and a referrer means nothing server-to-server, and
# **API restrictions: Routes API only**, which is then the only thing bounding it
# if it ever leaks. Set a budget alert on the project while you are there.
#
# Roughly ten requests per rep-day. Leave unset and the route returns 503 saying
# so, rather than failing in some less obvious way.
GOOGLE_ROUTES_API_KEY=

# Sentry error monitoring. Public by design — a DSN can only SEND events to
# your project, never read them, which is why it lives in client code.
# Leave unset to switch monitoring off entirely (developer machines).
NEXT_PUBLIC_SENTRY_DSN=
